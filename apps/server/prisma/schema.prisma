/// Phone sync (Phase 5): every operation a phone sends, by its own id, so a resend after a
/// dropped connection returns the first answer instead of applying it twice.
model SyncOperation {
  id         String   @id @default(cuid())
  /// The school this row belongs to (from the request's school; row-level security).
  schoolId   String   @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  userId     String
  /// The id the phone gave the operation
  opId       String
  deviceId   String?
  type       String
  /// PROCESSING while it runs, then APPLIED or REJECTED
  status     String
  /// What the phone was told (the same answer is returned for a resend)
  response   Json?
  receivedAt DateTime @default(now())
  finishedAt DateTime?

  @@unique([schoolId, userId, opId])
  @@index([schoolId])
  @@index([userId, receivedAt])
  @@map("sync_operations")
}


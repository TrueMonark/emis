  status         AttendanceStatus
  remarks        String?
  markedById     String?
  markedBy       TeacherProfile?  @relation("SpecialClassMarker", fields: [markedById], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([specialClassId, studentId])
  @@index([schoolId])
  @@index([studentId])
  @@map("special_class_attendance")

  name        String
  description String?
  template    String
  variables   String[] @default([])
  isActive    Boolean  @default(true)
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([category])
  @@index([isActive])
  @@index([schoolId])
  @@map("sms_templates")
}

model Notification {
  id                String               @id @default(cuid())
  /// The school this row belongs to. Filled in by the database from the request's school;
  /// row-level security only shows the current school's rows (see lib/db/tenant.ts).
  schoolId String @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  senderId          String
  recipientId       String
  subject           String
  message           String
  type              NotificationType     @default(GENERAL)
  priority          NotificationPriority @default(NORMAL)
  status            NotificationStatus   @default(UNREAD)
  relatedEntityType String?
  relatedEntityId   String?
  readAt            DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  recipient         User                 @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  sender            User                 @relation("SentNotifications", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([recipientId, status])
  @@index([senderId])
  @@index([createdAt])
  @@index([type])
  @@index([schoolId])
  @@map("notifications")
}


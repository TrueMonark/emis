  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  office    EducationOffice  @relation(fields: [officeId], references: [id], onDelete: Restrict)

  @@unique([userId, officeId])
  @@index([officeId, status])
  @@map("office_memberships")
}

/// Who did what, for actions above the school or about accounts: schools and accounts created,
/// setup finished, EMIS numbers changed, memberships ended, password resets. Never edited.
model AuditLog {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  actorUserId String?
  /// e.g. SCHOOL_CREATED, ACCOUNT_CREATED, SETUP_COMPLETED
  action      String
  targetType  String
  targetId    String?
  /// The school / office the action concerns (for scoping who may read it)
  schoolId    String?
  officeId    String?
  /// One readable line, e.g. "Created Kaliwe Heights Secondary School (EMIS 1234)"
  summary     String
  details     Json?

  @@index([officeId, at])
  @@index([schoolId, at])
  @@index([actorUserId, at])
  @@map("audit_log")
}

enum PasswordResetStatus {

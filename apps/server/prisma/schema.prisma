}

/// "Forgot password?" (Phase 4b): a request for a new one-time password, handled by the head
/// teacher/deputy of the person's school, or the office above (see passwordReset.service.ts).
/// Exactly one of handlerSchoolId / handlerOfficeId says who may handle it.
model PasswordResetRequest {
  id              String              @id @default(cuid())
  userId          String
  status          PasswordResetStatus @default(OPEN)
  requestedAt     DateTime            @default(now())
  /// The school whose head/deputy handle it (the person's own school)
  handlerSchoolId String?
  /// The office whose head handles it (DEBS, PEO or HQ)
  handlerOfficeId String?
  handledById     String?
  handledAt       DateTime?
  user            User                @relation("ResetRequester", fields: [userId], references: [id], onDelete: Cascade)
  handledBy       User?               @relation("ResetHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([handlerSchoolId, status])
  @@index([handlerOfficeId, status])
  @@map("password_reset_requests")
}


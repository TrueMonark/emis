generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AcademicYear {
  id                        String                     @id @default(cuid())
  /// Goes up by one on every change (database trigger); phones send the version they last saw.
  version   Int @default(1)
  /// The school this row belongs to. Filled in by the database from the request's school;
  /// row-level security only shows the current school's rows (see lib/db/tenant.ts).
  schoolId String @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  year                      Int
  startDate                 DateTime
  endDate                   DateTime
  isActive                  Boolean                    @default(false)
  isClosed                  Boolean                    @default(false)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  classTeacherAssignments   ClassTeacherAssignment[]
  classTimetables           ClassTimetable[]
  reportCards               ReportCard[]               @relation("ReportCardAcademicYear")
  secondaryTimetables       SecondaryTimetable[]
  enrollments               StudentClassEnrollment[]
  subjectTeacherAssignments SubjectTeacherAssignment[]
  terms                     Term[]
  timetableConfiguration    TimetableConfiguration?
  timetableSlots            TimetableSlot[]

  fees                      Fee[]
  feeDiscounts              FeeDiscount[]
  @@unique([schoolId, year])
  @@index([schoolId])
  @@map("academic_years")
}

model Term {
  id                      String                   @id @default(cuid())
  /// Goes up by one on every change (database trigger); phones send the version they last saw.
  version   Int @default(1)
  /// The school this row belongs to. Filled in by the database from the request's school;
  /// row-level security only shows the current school's rows (see lib/db/tenant.ts).
  schoolId String @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYearId          String
  termType                TermType
  startDate               DateTime
  endDate                 DateTime
  isActive                Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  assessmentWindows       AssessmentWindow[]
  assessments             Assessment[]
  attendanceRecords       AttendanceRecord[]
  specialClasses          SpecialClass[]
  classTimetables         ClassTimetable[]
  reportCards             ReportCard[]
  secondaryTimetables     SecondaryTimetable[]
  academicYear            AcademicYear             @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  timetableConfigurations TimetableConfiguration[]

  fees                    Fee[]
  @@unique([academicYearId, termType])
  @@index([schoolId])
  @@map("terms")
}

/// A year level at one school ("Grade 8", "Form 1", "Reception", "Level 2", "16+").
/// Phase 3b: each school has its own list, so Grade 9 and Form 1 can run side by side during
/// the Grade → Form changeover. The model keeps its old name (Grade) to avoid renaming it
/// across the code; screens call it "year level".
model Grade {
  id                        String                     @id @default(cuid())
  /// Goes up by one on every change (database trigger); phones send the version they last saw.
  version   Int @default(1)
  /// The school this row belongs to. Filled in by the database from the request's school;
  /// row-level security only shows the current school's rows (see lib/db/tenant.ts).
  schoolId                  String                     @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  /// Old fixed grade number (GRADE_1 … GRADE_12). Only for 2013-curriculum grades; empty for
  /// Forms, ECE and LSEND levels. Don't use it for rules — use stage, curriculum and exam.
  level                     GradeLevel?
  name                      String
  /// Short label for tight spaces: "G8", "F1", "REC"
  shortName                 String?
  /// Kept in step with stage (PRIMARY for ECE and primary stages, otherwise SECONDARY)
  schoolLevel               SchoolLevel
  stage                     YearStage
  curriculum                Curriculum                 @default(LEGACY_2013)
  /// National exam taken at the end of this level, if any
  exam                      NationalExam               @default(NONE)
  /// Order within the school (1 = first)
  sequence                  Int
  /// Where learners normally go next. Not "sequence + 1": Grade 7 → Form 1, Grade 12 → Form 5.
  nextGradeId               String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  classes                   Class[]
  subjects                  GradeSubject[]
  nextGrade                 Grade?                     @relation("GradeProgression", fields: [nextGradeId], references: [id], onDelete: SetNull)
  previousGrades            Grade[]                    @relation("GradeProgression")
  subjectPeriodRequirements SubjectPeriodRequirement[]

  feeTargets   FeeTarget[]
  @@unique([schoolId, sequence])
  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([nextGradeId])
  @@map("grades")
}

/// National subject catalogue (2023 Curriculum Framework). One list for the whole country;
/// each school picks what it offers (a school Subject linked to a catalogue entry) and can add
/// local subjects of its own.
model CatalogueSubject {
  id               String        @id @default(cuid())
  /// Stable code, e.g. "ENG", "MATH", "CIVIC"
  code             String        @unique
  name             String
  /// Framework subject group, e.g. "Language and Literature"
  groupName        String
  /// O-level group number (1–9) when the framework gives one
  groupNumber      Int?
  /// Stages the subject is taught at
  stages           YearStage[]
  /// Default periods per week by stage, e.g. {"O_LEVEL": 6, "A_LEVEL": 6}
  periodsPerWeek   Json?
  /// Compulsory for every learner at O-level (English, Mathematics, Civic Education)
  compulsoryOLevel Boolean       @default(false)
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  schoolSubjects   Subject[]

  @@map("catalogue_subjects")
}

/// National list of O-level and A-level pathways with their subject rules (as data, see
/// packages/shared/src/curriculum/pathways.ts for the rule shape).
model Pathway {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  stage          YearStage
  /// Subject rules: compulsory codes, "choose N from" groups, min/max subjects, notes
  rules          Json
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  schoolPathways SchoolPathway[]
  classes        Class[]
  enrollments    StudentClassEnrollment[]

  @@map("pathways")
}

/// Which pathways a school offers (depends on its staff, rooms and equipment).
model SchoolPathway {
  id        String   @id @default(cuid())
  /// The school this row belongs to. Filled in by the database from the request's school;
  /// row-level security only shows the current school's rows (see lib/db/tenant.ts).
  schoolId  String   @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  pathwayId String
  pathway   Pathway  @relation(fields: [pathwayId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([schoolId, pathwayId])
  @@index([schoolId])
  @@map("school_pathways")
}

model Class {
  id                        String                     @id @default(cuid())
  /// Goes up by one on every change (database trigger); phones send the version they last saw.
  version   Int @default(1)
  /// The school this row belongs to. Filled in by the database from the request's school;
  /// row-level security only shows the current school's rows (see lib/db/tenant.ts).
  schoolId String @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  name                      String
  gradeId                   String
  capacity                  Int                        @default(40)
  currentEnrolled           Int?
  status                    ClassStatus                @default(ACTIVE)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  deletedAt                 DateTime?
  assessments               Assessment[]
  attendanceRecords         AttendanceRecord[]         @relation("ClassAttendance")
  classSubjects             ClassSubject[]
  classTeacherAssignments   ClassTeacherAssignment[]
  registerCovers            RegisterCover[]
  specialClasses            SpecialClass[]
  classTimetables           ClassTimetable[]
  grade                     Grade                      @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  /// Optional: the pathway this class follows (O-level and A-level classes)
  pathwayId                 String?
  pathway                   Pathway?                   @relation(fields: [pathwayId], references: [id], onDelete: SetNull)
  reportCards               ReportCard[]
  secondaryTimetables       SecondaryTimetable[]
  enrollments               StudentClassEnrollment[]
  subjectTeacherAssignments SubjectTeacherAssignment[]
  timetableSlots            TimetableSlot[]

  feeTargets                FeeTarget[]
  @@unique([schoolId, gradeId, name])
  @@index([gradeId, status])
  @@index([schoolId])
  @@map("classes")
}

model Subject {
  id                        String                     @id @default(cuid())
  /// Goes up by one on every change (database trigger); phones send the version they last saw.
  version   Int @default(1)
  /// The school this row belongs to. Filled in by the database from the request's school;
  /// row-level security only shows the current school's rows (see lib/db/tenant.ts).
  schoolId String @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  code                      String
  name                      String
  description               String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  departmentId              String?
  /// The national catalogue entry this subject offers; empty for a school's own local subject
  catalogueSubjectId        String?
  catalogueSubject          CatalogueSubject?          @relation(fields: [catalogueSubjectId], references: [id], onDelete: SetNull)
  deletedAt                 DateTime?
  assessments               Assessment[]
  classSubjects             ClassSubject[]
  classTimetables           ClassTimetable[]
  gradeSubjects             GradeSubject[]
  reportCardSubjects        ReportCardSubject[]
  secondaryTimetables       SecondaryTimetable[]
  subjectPeriodRequirements SubjectPeriodRequirement[]
  subjectTeacherAssignments SubjectTeacherAssignment[]
  department                Department?                @relation(fields: [departmentId], references: [id])
  teacherSubjects           TeacherSubject[]
  timetableSlots            TimetableSlot[]

  specialClasses     SpecialClass[]
  @@unique([schoolId, code])
  @@index([departmentId])
  @@index([schoolId])
  @@index([catalogueSubjectId])
  @@map("subjects")
}

model GradeSubject {
  id        String  @id @default(cuid())
  /// The school this row belongs to. Filled in by the database from the request's school;
  /// row-level security only shows the current school's rows (see lib/db/tenant.ts).
  schoolId String @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  gradeId   String
  subjectId String
  isCore    Boolean @default(true)
  grade     Grade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([gradeId, subjectId])
  @@index([gradeId])
  @@index([subjectId])
  @@index([schoolId])
  @@map("grade_subjects")
}

model Department {
  id           String              @id @default(cuid())
  /// The school this row belongs to. Filled in by the database from the request's school;
  /// row-level security only shows the current school's rows (see lib/db/tenant.ts).
  schoolId String @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  name         String
  code         String
  description  String?
  status       DepartmentStatus    @default(ACTIVE)
  hodTeacherId String?             @unique
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  hodTeacher   TeacherProfile?     @relation("DepartmentHOD", fields: [hodTeacherId], references: [id])
  subjects     Subject[]
  teachers     TeacherDepartment[]

  @@unique([schoolId, code])
  @@index([status])
  @@index([schoolId])
  @@map("departments")
}

model Student {
  id                 String                    @id @default(cuid())
  /// Goes up by one on every change (database trigger); phones send the version they last saw.
  version   Int @default(1)
  /// The school this row belongs to. Filled in by the database from the request's school;
  /// row-level security only shows the current school's rows (see lib/db/tenant.ts).
  schoolId String @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  /// The school's own admission number
  studentNumber      String
  /// System-wide learner number, e.g. ZM26-4K7Q2PB-X (year of first registration, 7
  /// characters, check character). Unique nationally, never reused, follows the learner.
  /// Filled in by the database (emis_new_learner_number()) when a learner is created.
  learnerNumber      String                    @unique @default(dbgenerated("emis_new_learner_number()"))
  firstName          String
  middleName         String?
  lastName           String
  dateOfBirth        DateTime
  gender             Gender
  admissionDate      DateTime
  status             StudentStatus             @default(ACTIVE)
  address            String?
  medicalInfo        String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  deletedAt          DateTime?
  vulnerability      VulnerabilityStatus       @default(NOT_VULNERABLE)
  orphanType         OrphanType?
  deceasedParent     DeceasedParent?
  statusChangeReason String?
  attendanceRecords  AttendanceRecord[]
  specialClassAttendance SpecialClassAttendance[]
  markChanges            MarkChange[]
  reportCards        ReportCard[]
  smsLogs            SMSLog[]
  assessmentResults  StudentAssessmentResult[]
  enrollments        StudentClassEnrollment[]
  studentGuardians   StudentGuardian[]
  promotions         StudentPromotion[]

  feeCharges         FeeCharge[]
  feeDiscounts       FeeDiscount[]
  feePayments        FeePayment[]
  @@unique([schoolId, studentNumber])
  @@index([status])
  @@index([studentNumber])
  @@index([admissionDate])
  @@index([vulnerability])
  @@index([schoolId])
  @@map("students")
}

model Guardian {
  id               String            @id @default(cuid())
  /// The school this row belongs to. Filled in by the database from the request's school;
  /// row-level security only shows the current school's rows (see lib/db/tenant.ts).
  schoolId String @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  firstName        String
  lastName         String
  phone            String
  email            String?
  address          String?
  occupation       String?
  status           ParentStatus      @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  smsLogs          SMSLog[]
  studentGuardians StudentGuardian[]

  @@index([phone])
  @@index([email])
  @@index([schoolId])
  @@map("guardians")
}

model StudentGuardian {
  id           String             @id @default(cuid())
  /// The school this row belongs to. Filled in by the database from the request's school;
  /// row-level security only shows the current school's rows (see lib/db/tenant.ts).
  schoolId String @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentId    String
  guardianId   String
  relationship ParentRelationship
  isPrimary    Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  guardian     Guardian           @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student      Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([studentId])
  @@index([guardianId])
  @@index([schoolId])
  @@map("student_guardians")
}

model StudentClassEnrollment {
  id              String           @id @default(cuid())
  /// Goes up by one on every change (database trigger); phones send the version they last saw.
  version   Int @default(1)
  /// The school this row belongs to. Filled in by the database from the request's school;
  /// row-level security only shows the current school's rows (see lib/db/tenant.ts).
  schoolId String @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentId       String
  classId         String
  academicYearId  String
  enrollmentDate  DateTime         @default(now())
  status          EnrollmentStatus @default(ACTIVE)
  previousClassId String?
  changeReason    String?
  changedAt       DateTime?
  /// The learner's pathway this year (O-level / A-level); defaults to the class's pathway
  pathwayId       String?
  pathway         Pathway?         @relation(fields: [pathwayId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  academicYear    AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class           Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([classId, academicYearId])
  @@index([studentId, status])
  @@index([schoolId])
  @@map("student_class_enrollments")
}

model StudentPromotion {
  id             String          @id @default(cuid())
  /// The school this row belongs to. Filled in by the database from the request's school;
  /// row-level security only shows the current school's rows (see lib/db/tenant.ts).
  schoolId String @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentId      String
  /// Old grade numbers, kept for records made before Phase 3b; empty for Forms etc.
  fromGradeLevel GradeLevel?
  toGradeLevel   GradeLevel?
  /// Year levels at the school (Phase 3b onwards)
  fromGradeId    String?
  toGradeId      String?
  /// Names at the time of the promotion, so the record still reads right if a level is renamed
  fromGradeName  String?
  toGradeName    String?
  academicYear   Int
  status         PromotionStatus
  remarks        String?
  approvedById   String
  approvedAt     DateTime        @default(now())
  createdAt      DateTime        @default(now())
  approver       TeacherProfile  @relation("PromotionApprovals", fields: [approvedById], references: [id])
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, academicYear])
  @@index([academicYear, status])
  @@index([approvedById])
  @@index([schoolId])
  @@map("student_promotions")
}

model User {
  id                    String           @id @default(cuid())
  email                 String           @unique
  /// Mobile number for signing in, as +260XXXXXXXXX (unique: one account per number). Filled
  /// from the teacher profile's phone when that number isn't already someone else's.
  phone                 String?          @unique
  passwordHash          String
  role                  Role             @default(TEACHER)
  isActive              Boolean          @default(true)
  hasDefaultPassword    Boolean          @default(false)
  /// When a one-time password stops working. Null = no expiry (e.g. seeded demo accounts).
  temporaryPasswordExpiresAt DateTime?
  /// Name shown for accounts without a teacher profile (education office staff)
  displayName           String?
  lastLogin             DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  receivedNotifications Notification[]   @relation("ReceivedNotifications")
  sentNotifications     Notification[]   @relation("SentNotifications")
  profile               TeacherProfile?
  userPermissions       UserPermission[] @relation("UserPermissions")
  schoolMemberships     SchoolMembership[]
  officeMemberships     OfficeMembership[]
  passwordResetRequests PasswordResetRequest[] @relation("ResetRequester")
  handledResetRequests  PasswordResetRequest[] @relation("ResetHandler")

  @@index([email])
  @@index([role])
  @@map("users")
}

model TeacherProfile {
  id                        String                     @id @default(cuid())
  userId                    String                     @unique
  staffNumber               String                     @unique
  firstName                 String
  middleName                String?
  lastName                  String
  dateOfBirth               DateTime
  gender                    Gender
  phone                     String
  address                   String?
  qualification             QualificationLevel
  yearsExperience           Int                        @default(0)
  status                    StaffStatus                @default(ACTIVE)
  hireDate                  DateTime
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  deletedAt                 DateTime?
  attendanceMarked          AttendanceRecord[]         @relation("AttendanceMarker")
  classTeacherAssignments   ClassTeacherAssignment[]
  primaryTimetables         ClassTimetable[]           @relation("PrimaryTimetable")
  departmentAsHOD           Department?                @relation("DepartmentHOD")
  reportCardRemarks         ReportCard[]
  secondaryTimetables       SecondaryTimetable[]       @relation("SecondaryTimetable")
  promotionApprovals        StudentPromotion[]         @relation("PromotionApprovals")
  subjectTeacherAssignments SubjectTeacherAssignment[]
  departments               TeacherDepartment[]
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects                  TeacherSubject[]
  timetableConfigurations   TimetableConfiguration[]
  timetableSlots            TimetableSlot[]
  permissionGrants          UserPermission[]           @relation("PermissionGrants")
  lessonLogs                LessonLog[]
  registerCovers            RegisterCover[]            @relation("RegisterCoverTeacher")
  specialClasses            SpecialClass[]             @relation("SpecialClassTeacher")
  specialClassMarks         SpecialClassAttendance[]   @relation("SpecialClassMarker")

  @@index([staffNumber])
  @@index([status])
  @@map("teacher_profiles")
}


// =====================================================================
// National structure (Phase 3a). Global tables: not filtered by school.
// =====================================================================

enum EducationOfficeType {
  HQ
  PROVINCIAL
  DISTRICT
}

enum EmisNumberStatus {
  CONFIRMED
  PENDING
  DISPUTED
}

enum SchoolCategory {
  PUBLIC
  AIDED
  COMMUNITY
  PRIVATE
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  /// A transfer waiting for confirmation: the person can't act in this school yet.
  PENDING
  ACTIVE
  ENDED
}

/// Ministry HQ, provincial offices (PEO) and district offices (DEBS). Its own tree, not the
/// administrative map: the Education Act lets education districts differ (ss.6–7).
model EducationOffice {
  id        String              @id @default(cuid())
  type      EducationOfficeType
  name      String
  code      String?             @unique
  parentId  String?
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  parent    EducationOffice?    @relation("OfficeTree", fields: [parentId], references: [id])
  children  EducationOffice[]   @relation("OfficeTree")
  schools   School[]
  memberships OfficeMembership[]
  returnRounds ReturnRound[]

  @@index([parentId])
  @@index([type])
  @@map("education_offices")
}

/// A school. The EMIS number is the official ID, but official lists contain duplicates and
/// errors, so a school can exist with a PENDING number.
model School {
  id               String           @id @default(cuid())
  name             String
  emisNumber       String?          @unique
  emisStatus       EmisNumberStatus @default(PENDING)
  category         SchoolCategory   @default(PUBLIC)
  /// e.g. the church running an aided school
  agency           String?
  districtOfficeId String
  status           SchoolStatus     @default(ACTIVE)
  /// When the head teacher finished the first-time setup (school details, academic year and
  /// terms, year levels). Until then the school's pages are limited to the setup wizard.
  setupCompletedAt DateTime?
  /// School fees module (the Finance role and its pages). Always on for private schools; the
  /// DEBS can switch it on for others (e.g. community schools charging PTA fees).
  feesEnabled      Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  districtOffice   EducationOffice  @relation(fields: [districtOfficeId], references: [id])
  memberships      SchoolMembership[]
  academicYears              AcademicYear[]
  terms                      Term[]
  classes                    Class[]
  subjects                   Subject[]
  gradeSubjects              GradeSubject[]
  departments                Department[]
  students                   Student[]
  guardians                  Guardian[]
  studentGuardians           StudentGuardian[]
  studentClassEnrollments    StudentClassEnrollment[]
  studentPromotions          StudentPromotion[]
  teacherSubjects            TeacherSubject[]
  teacherDepartments         TeacherDepartment[]
  classTeacherAssignments    ClassTeacherAssignment[]
  subjectTeacherAssignments  SubjectTeacherAssignment[]
  classSubjects              ClassSubject[]
  timetableConfigurations    TimetableConfiguration[]
  timetableSlots             TimetableSlot[]
  lessonLogs                 LessonLog[]
  rooms                      Room[]
  timeSlots                  TimeSlot[]
  classTimetables            ClassTimetable[]
  secondaryTimetables        SecondaryTimetable[]
  subjectPeriodRequirements  SubjectPeriodRequirement[]
  assessments                Assessment[]
  assessmentWindows          AssessmentWindow[]
  studentAssessmentResults   StudentAssessmentResult[]
  reportCards                ReportCard[]
  reportCardSubjects         ReportCardSubject[]
  attendanceRecords          AttendanceRecord[]
  registerCovers             RegisterCover[]
  specialClasses             SpecialClass[]
  specialClassAttendance     SpecialClassAttendance[]
  syncOperations             SyncOperation[]
  schoolClosures             SchoolClosure[]
  markChanges                MarkChange[]
  fees                       Fee[]
  feeTargets                 FeeTarget[]
  feeInstalments             FeeInstalment[]
  feeCharges                 FeeCharge[]
  feeDiscounts               FeeDiscount[]
  feePayments                FeePayment[]
  grades                     Grade[]
  schoolPathways             SchoolPathway[]
  userPermissions            UserPermission[]
  settings                   SystemSettings[]
  smsLogs                    SMSLog[]
  smsTemplates               SMSTemplate[]
  notifications              Notification[]
  facilities                 SchoolFacilities?
  returns                    SchoolReturn[]

  @@index([districtOfficeId])
  @@map("schools")
}

/// A person's role at a school. At most one ACTIVE membership per person (a partial unique
/// index in the migration enforces it); a transfer adds a PENDING one at the new school.
/// User.role mirrors the role of the ACTIVE membership.
model SchoolMembership {
  id          String           @id @default(cuid())
  userId      String
  schoolId    String
  role        Role
  status      MembershipStatus @default(ACTIVE)
  startDate   DateTime         @default(now())
  endDate     DateTime?
  /// Transfers (Phase 4b): who asked for this PENDING membership (the receiving school's head
  /// or deputy, or the DEBS), and who confirmed it (the old school's head/deputy or the DEBS).
  requestedById String?
  requestedAt   DateTime?
  confirmedById String?
  confirmedAt   DateTime?
  /// How the membership ended: TRANSFERRED (to another school) or LEFT
  endReason     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([userId, schoolId])
  @@index([schoolId, status])
  @@map("school_memberships")
}


/// Every mark entered, changed or deleted (written by a database trigger on
/// student_assessment_results, whatever the path), plus phone changes that were not applied
/// because a newer mark was already there. Never changed or deleted by the app.
model MarkChange {
  id           String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  schoolId     String           @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school       School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  /// The result row (kept after the result is deleted, so no foreign key)
  resultId     String?
  assessmentId String
  assessment   Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  action       MarkChangeAction
  oldMarks     Float?
  newMarks     Float?
  oldAbsent    Boolean?
  newAbsent    Boolean?
  oldRemarks   String?
  newRemarks   String?
  /// The user who made the change (null: the system, e.g. the seed)
  changedById  String?
  /// WEB, PHONE or SYSTEM
  source       String
  note         String?
  /// UTC, filled in by the database (the trigger's lines and the app's alike)
  changedAt    DateTime         @default(dbgenerated("timezone('UTC'::text, now())"))

  @@index([schoolId])
  @@index([assessmentId, studentId, changedAt])
  @@map("mark_changes")
}

enum MarkChangeAction {
  CREATED
  CHANGED
  DELETED
  /// A phone sent an older change; the newer mark was kept
  PHONE_NOT_APPLIED
}

// =====================================================================
// School fees (requested 19 October 2026). Amounts are whole ngwee (K1 = 100 ngwee) so sums are
// exact. School-owned (row-level security). Only schools with School.feesEnabled use them.
// =====================================================================

enum FeeCategory {
  TUITION
  BOARDING
  TRANSPORT
  MEALS
  EXAMINATION
  UNIFORM
  BOOKS
  DEVELOPMENT
  TRIP
  EVENT
  OTHER
}

/// Who a fee is charged to
enum FeeTargetKind {
  /// Every learner on a class list this academic year
  ALL
  /// Learners in the chosen year levels
  YEAR_LEVELS
  /// Learners in the chosen classes
  CLASSES
  /// Only the learners added one by one (e.g. who signed up for a trip)
  LEARNERS
}

enum FeePaymentMethod {
  CASH
  BANK_DEPOSIT
  BANK_TRANSFER
  MOBILE_MONEY
  CHEQUE
  OTHER
}

enum FeePaymentStatus {
  RECORDED
  /// Cancelled (wrong entry, bounced cheque). Kept with the reason; never deleted.
  VOIDED
}

enum FeeDiscountKind {
  /// value = percent (1–100)
  PERCENT
  /// value = ngwee off each matching fee
  AMOUNT
}

/// Something learners are charged: a term's tuition for a year level, a trip, exam fees…
model Fee {
  id             String         @id @default(cuid())
  schoolId       String         @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school         School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  name           String
  category       FeeCategory
  description    String?
  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  /// The term it's for (null: a one-off or whole-year charge)
  termId         String?
  term           Term?          @relation(fields: [termId], references: [id], onDelete: Restrict)
  /// Per learner, in ngwee
  amountNgwee    Int
  /// When it must be paid in full (instalments, if any, set earlier dates for parts)
  dueDate        DateTime
  targetKind     FeeTargetKind
  /// Optional (e.g. a trip): learners are added when they sign up, never automatically
  optional       Boolean        @default(false)
  /// No longer charged to new learners or listed by default; existing charges stay
  archived       Boolean        @default(false)
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  targets        FeeTarget[]
  instalments    FeeInstalment[]
  charges        FeeCharge[]
  payments       FeePayment[]

  @@index([schoolId])
  @@index([academicYearId, termId])
  @@map("fees")
}

/// The year levels or classes a fee is for (targetKind YEAR_LEVELS / CLASSES)
model FeeTarget {
  id       String  @id @default(cuid())
  schoolId String  @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  feeId    String
  fee      Fee     @relation(fields: [feeId], references: [id], onDelete: Cascade)
  gradeId  String?
  grade    Grade?  @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  classId  String?
  class    Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([feeId])
  @@map("fee_targets")
}

/// A payment plan: parts of a fee due by set dates (percents add up to 100)
model FeeInstalment {
  id       String   @id @default(cuid())
  schoolId String   @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school   School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  feeId    String
  fee      Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)
  label    String
  dueDate  DateTime
  percent  Int

  @@index([schoolId])
  @@index([feeId])
  @@map("fee_instalments")
}

/// One learner owing one fee. amount = original − discount (discounts are recalculated when they change).
model FeeCharge {
  id             String   @id @default(cuid())
  schoolId       String   @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  feeId          String
  fee            Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  originalNgwee  Int
  discountNgwee  Int      @default(0)
  amountNgwee    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([feeId, studentId])
  @@index([schoolId])
  @@index([studentId])
  @@map("fee_charges")
}

/// A discount or bursary for a learner in an academic year, on some fee categories (none = all)
model FeeDiscount {
  id             String          @id @default(cuid())
  schoolId       String          @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentId      String
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  /// e.g. "Sibling discount", "Bursary: Lusaka Rotary Club"
  name           String
  kind           FeeDiscountKind
  value          Int
  /// The fee categories it applies to; empty = every fee
  categories     FeeCategory[]
  reason         String?
  createdById    String?
  createdAt      DateTime        @default(now())
  /// Ended (no longer applies; charges are recalculated)
  endedAt        DateTime?

  @@index([schoolId])
  @@index([studentId, academicYearId])
  @@map("fee_discounts")
}

/// Money received for a learner. Numbered receipts; voided payments are kept.
model FeePayment {
  id            String           @id @default(cuid())
  schoolId      String           @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school        School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentId     String
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  /// e.g. "RCT-2026-000123", numbered per school and year
  receiptNumber String
  amountNgwee   Int
  method        FeePaymentMethod
  /// Bank slip / transfer reference, mobile money transaction id, cheque number
  reference     String?
  payerName     String?
  /// The day the money was received
  paidOn        DateTime
  /// Paid towards this fee (e.g. a trip); otherwise it pays the oldest balances first
  feeId         String?
  fee           Fee?             @relation(fields: [feeId], references: [id], onDelete: Restrict)
  notes         String?
  status        FeePaymentStatus @default(RECORDED)
  voidReason    String?
  voidedById    String?
  voidedAt      DateTime?
  receivedById  String
  /// MANUAL (recorded by finance staff). A future bank / mobile money gateway records its own.
  source        String           @default("MANUAL")
  createdAt     DateTime         @default(now())

  @@unique([schoolId, receiptNumber])
  @@index([schoolId])
  @@index([studentId])
  @@index([paidOn])
  @@map("fee_payments")
}

/// The last receipt number used, per school and year (taken with a row lock, so numbers never repeat)
model FeeReceiptCounter {
  schoolId String @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  year     Int
  last     Int    @default(0)

  @@id([schoolId, year])
  @@map("fee_receipt_counters")
}

// ── Phase 7 (31 October 2026): school profile indicators and returns ─────────────────────────

/// A school's facilities (the Annual School Census categories), kept up to date by the head or
/// deputy on the School profile page. National table like `schools`: the offices over the school
/// read it; the app only lets the school's own leaders change it.
model SchoolFacilities {
  schoolId     String       @id
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classrooms   Int?
  desks        Int?
  toiletsBoys  Int?
  toiletsGirls Int?
  toiletsStaff Int?
  waterSource  WaterSource?
  power        PowerSource?
  internet     Boolean?
  notes        String?
  updatedById  String?
  updatedAt    DateTime     @updatedAt

  @@map("school_facilities")
}

enum WaterSource {
  PIPED
  BOREHOLE
  PROTECTED_WELL
  UNPROTECTED_WELL
  SURFACE_WATER
  RAINWATER
  NONE
}

enum PowerSource {
  GRID
  SOLAR
  GENERATOR
  NONE
}

/// A return the office asks its schools for ("2026 Annual School Census", "Term 3 return"),
/// opened by HQ, a PEO or a DEBS for every school in its area. A school's return starts as a
/// draft filled in from its records the first time the head opens it.
model ReturnRound {
  id           String            @id @default(cuid())
  title        String
  instructions String?
  /// The office that opened it; every active school in its area answers
  officeId     String
  office       EducationOffice   @relation(fields: [officeId], references: [id])
  /// Attendance, admissions and leavers are counted between these dates
  periodStart  DateTime          @db.Date
  periodEnd    DateTime          @db.Date
  dueDate      DateTime          @db.Date
  status       ReturnRoundStatus @default(OPEN)
  openedById   String
  closedAt     DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  returns      SchoolReturn[]

  @@index([officeId])
  @@map("return_rounds")
}

enum ReturnRoundStatus {
  OPEN
  CLOSED
}

/// One school's answer to a round. Draft → Submitted → Approved, or Returned for correction
/// (then the head corrects it and submits again). National table: only figures (counts), never
/// learners' names, so the offices over the school can read it.
model SchoolReturn {
  id              String             @id @default(cuid())
  roundId         String
  round           ReturnRound        @relation(fields: [roundId], references: [id], onDelete: Restrict)
  schoolId        String
  school          School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  status          SchoolReturnStatus @default(DRAFT)
  /// Counts worked out from the school's records (`ReturnFigures`, @school/shared/returns/indicators)
  figures         Json
  /// The facilities as the school reports them in this return (`FacilitiesData`)
  facilities      Json
  figuresAt       DateTime
  remarks         String?
  submissionCount Int                @default(0)
  submittedAt     DateTime?
  submittedById   String?
  reviewedAt      DateTime?
  reviewedById    String?
  reviewComment   String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  events          SchoolReturnEvent[]

  @@unique([roundId, schoolId])
  @@index([schoolId])
  @@map("school_returns")
}

enum SchoolReturnStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
}

/// Every step of a return (who, when, comment; the figures as submitted). Only ever added to.
model SchoolReturnEvent {
  id         String            @id @default(cuid())
  returnId   String
  return     SchoolReturn      @relation(fields: [returnId], references: [id], onDelete: Cascade)
  action     ReturnEventAction
  byUserId   String?
  comment    String?
  figures    Json?
  facilities Json?
  at         DateTime          @default(now())

  @@index([returnId, at])
  @@map("school_return_events")
}

enum ReturnEventAction {
  STARTED
  REFRESHED
  SAVED
  SUBMITTED
  RETURNED
  APPROVED
  REOPENED
}

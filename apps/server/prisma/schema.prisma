  CANCELLED
}

/// A lesson outside the timetable on a Saturday or Sunday (Phase 5, requested 18 October 2026).
/// Attendance can't be taken on a weekend except here: the teacher who asked for the class takes
/// its register, and only once the HOD of the subject's department (or the head/deputy) approved it.
model SpecialClass {
  id             String             @id @default(cuid())
  /// Goes up by one on every change (database trigger); phones send the version they last saw.
  version        Int                @default(1)
  /// The school this row belongs to. Filled in by the database from the request's school;
  /// row-level security only shows the current school's rows (see lib/db/tenant.ts).
  schoolId       String             @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school         School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classId        String
  class          Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  termId         String
  term           Term               @relation(fields: [termId], references: [id], onDelete: Cascade)
  /// The teacher who asked for it and teaches it
  teacherId      String
  teacher        TeacherProfile     @relation("SpecialClassTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  /// The day (UTC midnight, like attendance dates); always a Saturday or Sunday
  date           DateTime
  /// "08:00"
  startTime      String
  endTime        String
  topic          String
  venue          String?
  reason         String?
  status         SpecialClassStatus @default(PENDING)
  /// The user who approved / turned it down, and when
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  attendance     SpecialClassAttendance[]

  @@index([schoolId])
  @@index([classId, date])
  @@index([teacherId, date])
  @@index([status])
  @@map("special_classes")
}

/// The register of one special (weekend) class: one row per learner.
model SpecialClassAttendance {
  id             String           @id @default(cuid())
  /// Goes up by one on every change (database trigger); phones send the version they last saw.
  version        Int              @default(1)
  /// The school this row belongs to. Filled in by the database from the request's school;
  /// row-level security only shows the current school's rows (see lib/db/tenant.ts).
  schoolId       String           @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  specialClassId String
  specialClass   SpecialClass     @relation(fields: [specialClassId], references: [id], onDelete: Cascade)
  studentId      String

/// Phase 3c: every change to a syncable table, recorded by database triggers (so no code path
/// can forget it). Phones ask "what changed since my cursor?". Deletes appear here as op DELETE —
/// the row itself is gone, this line is its tombstone. Read-only for the app.
model ChangeLog {
  seq       BigInt   @id @default(autoincrement())
  schoolId  String
  /// Table name, e.g. "attendance_records"
  entity    String
  entityId  String
  /// INSERT, UPDATE or DELETE
  op        String
  /// Transaction that made the change (pg_current_xact_id); the sync cursor is built on it
  txid      BigInt
  /// UTC, filled in by the database (trigger rows)
  changedAt DateTime @default(dbgenerated("timezone('UTC'::text, now())"))
  /// User who made the change (app.user_id), when known
  changedBy String?

  @@index([schoolId, txid, seq])
  @@index([schoolId, entity, entityId])
  @@map("change_log")
}


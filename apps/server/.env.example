# API server settings. Copy to apps/server/.env and fill in. Never commit .env.

# --- Required ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/emis_test"
# Long random string. No default on purpose: the server refuses to start without it.
JWT_SECRET="replace-with-a-long-random-string"

# --- Optional ---
# PORT=4000                  # when started on its own (npm run dev / npm start in apps/server)
# HOST=0.0.0.0
# JWT_EXPIRES_IN=7d
# OTP_TTL_HOURS=24            # how long a one-time password (new account / reset) works
# UPLOADS_DIR=/srv/school/uploads   # where the school logo is kept; set this in production
# DB_POOL_MAX=25
# PDF_CONCURRENCY=3
# API_BODY_LIMIT=10mb
# LOG_LEVEL=info

# --- Demo data (npm run db:seed, local development only) ---
# SEED_DEMO_PASSWORD=choose-a-local-test-password   # otherwise a random one is printed
# SEED_ALLOW_REMOTE=true                             # only if you really mean to seed a non-local DB

# --- SMS (can also be set in the admin Settings screen) ---
# SMS_ACTIVE_PROVIDER=AFRICAS_TALKING
# AFRICAS_TALKING_USERNAME=
# AFRICAS_TALKING_API_KEY=
# AFRICAS_TALKING_SENDER_ID=
# AFRICASTALKING_ENV=production
# SMS_GATEWAY_USERNAME=
# SMS_GATEWAY_PASSWORD=
# SMS_GATEWAY_DEVICE_ID=

  SECONDARY
  PERMISSIBLE
}

model TeacherSubject {
  id        String             @id @default(cuid())
  /// The school this row belongs to. Filled in by the database from the request's school;
  /// row-level security only shows the current school's rows (see lib/db/tenant.ts).
  schoolId String @default(dbgenerated("current_setting('app.school_id'::text, true)"))
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  teacherId String
  subjectId String
  // Distinguishes the teacher's main qualified subject, an optional second
  // qualified subject, and up to 2 department-scoped subjects they're merely
  // permitted (not necessarily qualified) to teach. Needed so an edit form
  // can reliably tell which existing row is which — without this, editing a
  // teacher had no way to know which of their subjects to preselect as
  // "primary" vs "secondary" and risked overwriting them with the wrong ones.
  role      TeacherSubjectRole @default(PERMISSIBLE)
  createdAt DateTime           @default(now())
  subject   Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   TeacherProfile     @relation(fields: [teacherId], references: [id], onDelete: Cascade)


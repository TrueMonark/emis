{
  "name": "schoolmanagement",
  "version": "0.1.0",
  "private": true,
  "description": "School Management System — one API server and database, one app per level (school now; DEBS/PEO office next).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,school -c blue,green \"npm run dev -w @school/server\" \"npm run dev -w @school/school\"",
    "dev:server": "npm run dev -w @school/server",
    "dev:school": "npm run dev -w @school/school",
    "build": "npm run build -w @school/server && npm run build -w @school/school",
    "start": "node server.js",
    "test": "npm test -w @school/server",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @school/server",
    "db:migrate": "npm run db:migrate -w @school/server",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @school/server",
    "db:migrate:status": "npm run db:migrate:status -w @school/server",
    "db:seed": "npm run db:seed -w @school/server",
    "db:studio": "npm run db:studio -w @school/server",
    "db:reset": "npm run db:reset -w @school/server",
    "app:restart": "node scripts/restart-app.cjs",
    "app:stop": "node scripts/stop-app.cjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "concurrently": "9.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "typescript": "^5"
  }
}
